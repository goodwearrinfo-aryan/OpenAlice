# Only the hand-maintained dashboard source is tracked here. Everything else in
# this tree is generated output or scratch state.
logs/
*.log

fleet-state/

# Generated data files served to the dashboard. Recreated by the launchd jobs.
ui/public/*.json
ui/public/candles*.json
ui/public/promo-*.json

# The hand-written pages. These are edited by hand (albeit minified) and losing
# them would lose the whole dashboard, so they are tracked.
!ui/public/*.html

__pycache__/
*.pyc
*.tmp
.DS_Store

# Pre-restructure backups of the console pages, kept on disk as a restore point
# but no longer tracked. They were working-tree cruft that outlived their reason:
# the pages they copied now live in openalice-fleet, and their content is still in
# this repository's history. Untracked rather than deleted so the local restore
# point survives.
ui/public/.orig-html-bak/
